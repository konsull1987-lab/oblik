rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function allowed() {
      return request.auth != null && request.auth.token.email_verified == true
        && email() in ['konsull1987@gmail.com', 'esmik7686@gmail.com'];
    }
    // общак на двох — лише Андрій і Сергій
    function duo() {
      return email() in ['konsull1987@gmail.com', 'esmik7686@gmail.com'];
    }
    // 📨 працівники (будь-який вхід через Google) можуть лише НАДІСЛАТИ повідомлення; читають і обробляють власники
    match /inbox/{id} { allow create: if request.auth != null; }
    match /{col}/{doc=**} {
      allow read, write: if allowed() && (!col.matches('(demo_)?duo_.*') || duo());
    }
  }
}
